# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env.bak

# ── Environment / secrets ─────────────────────────────────────────────────────
# .env.example IS committed (it is a public template)
.env

# ── Flask instance folder ─────────────────────────────────────────────────────
# Flask writes app.db and other instance-specific files here
instance/

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# ── Type checking & linting ───────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/

# ── Distribution / packaging ──────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ── IDEs & editors ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS-generated files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Alembic migration artefacts (keep the versions folder itself) ─────────────
# migrations/versions/*.pyc  ← already covered by *.pyc above
