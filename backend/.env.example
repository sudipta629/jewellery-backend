# .env.example
#
# Template for environment variables required by this project.
# Copy this file to .env and fill in your real values:
#
#   cp .env.example .env       (Linux / macOS)
#   copy .env.example .env    (Windows CMD)
#
# The .env file is NEVER committed to Git.

# ── Flask core ────────────────────────────────────────────────────────────────
FLASK_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-secret-key-here

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql+psycopg://username:password@host:port/database_name
# Replace YOUR_PASSWORD with your actual PostgreSQL password.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/jewellery_db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use the example value in production.
JWT_SECRET_KEY=your-strong-jwt-secret-key-here

# Access token lifetime — how long before users must re-authenticate.
# Short values (15m) are recommended for security.
# Supported suffixes: m (minutes), h (hours), d (days)
JWT_ACCESS_TOKEN_EXPIRES=15m

# Refresh token lifetime — how long the user stays "logged in".
# 30d is a common balance between convenience and security.
JWT_REFRESH_TOKEN_EXPIRES=30d

# ── OTP ───────────────────────────────────────────────────────────────────────
# How many minutes a generated OTP remains valid.
# 5 minutes is the industry standard for one-time passwords.
OTP_EXPIRY_MINUTES=5

# Maximum number of incorrect OTP attempts before the record is locked.
# After this many failures, the user must request a new OTP.
OTP_MAX_ATTEMPTS=5

# ── CORS ──────────────────────────────────────────────────────────────────────
# The URL of your React frontend.
# Development: http://localhost:5173
# Production: https://your-production-frontend-domain.com
FRONTEND_URL=http://localhost:5173

# ── Server binding (optional) ─────────────────────────────────────────────────
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
